# OpenAI is used for claim adjudication and policy-document embeddings.
OPENAI_API_KEY=

# PostgreSQL database used to persist claim decisions.
DB_CONNECTION_STRING=postgresql://user:password@localhost:5432/claims_db

# LangSmith observability. Set LANGSMITH_TRACING=false to disable tracing.
LANGSMITH_TRACING=true
# Use your LangSmith region endpoint, for example:
# https://api.smith.langchain.com or https://apac.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT="claim-review-desk"